# Copie para .env e ajuste conforme necessário.

# Banco: SQLite por padrão (zero setup, roda local).
# Para Postgres, troque por: postgresql+psycopg://usuario:senha@localhost:5432/ecotriagem
DATABASE_URL=sqlite:///./ecotriagem.db

# Segredo do JWT — TROQUE em qualquer uso fora do seu PC.
JWT_SECRET=troque-este-segredo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Inferência: "mock" devolve predições falsas (não depende do modelo do colega).
# Troque para "http" quando o serviço de inferência real estiver no ar.
INFERENCE_MODE=mock
INFERENCE_URL=http://localhost:8001

# Origens liberadas no CORS (frontend Vite roda em 5173).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Senha com que os usuários de demonstração são criados no primeiro boot.
SEED_PASSWORD=123456
