# Copie este arquivo para .env e preencha com os seus valores.

# Banco de dados. Padrão SQLite (local, zero setup).
# Para o Supabase, cole a string do "Session pooler" (porta 5432); pode colar como
# postgresql://... que o backend direciona pro driver certo.
DATABASE_URL=sqlite:///./ecotriagem.db

# Segredo usado para assinar os tokens JWT. Troque por um valor aleatório.
JWT_SECRET=troque-este-segredo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Inferência: "mock" devolve predições falsas (não depende do modelo real);
# "http" aponta para o serviço de inferência quando ele estiver no ar.
INFERENCE_MODE=mock
INFERENCE_URL=http://localhost:8001

# Origens liberadas no CORS (o frontend Vite roda em 5173).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Senha com que os usuários de demonstração são criados no primeiro boot.
SEED_PASSWORD=defina-uma-senha
